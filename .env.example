# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...

# The Operating Brief sender/reply
FROM_EMAIL=The Operating Brief <brief@yourdomain.com>
REPLY_TO_EMAIL=reply@yourdomain.com

# Sports digest sender/reply
SPORTS_FROM_EMAIL=The Sports Brief <sports@yourdomain.com>
SPORTS_REPLY_TO_EMAIL=reply@yourdomain.com

# Paddock Brief sender/reply
PADDOCK_FROM_EMAIL=The Paddock Brief <paddock@yourdomain.com>
PADDOCK_REPLY_TO_EMAIL=reply@yourdomain.com

# Preview auth token (for web preview links)
PREVIEW_TOKEN=your-secret-token

# Admin dashboard password (localhost:3000/admin)
ADMIN_PASSWORD=your-admin-password

# Claude model (optional — defaults to claude-opus-4-5)
# CLAUDE_MODEL=claude-sonnet-4-5
